{
  "name": "realoem-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BMW vehicle and parts catalog MCP for RealOEM",
  "bin": {
    "realoem-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "browser:install": "playwright install chromium",
    "format": "prettier --write \"{src,scripts,test}/**/*.ts\" package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check \"{src,scripts,test}/**/*.ts\" package.json tsconfig.json .prettierrc.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "cheerio": "^1.1.2",
    "playwright": "^1.56.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
