{
  "name": "realoem-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BMW vehicle and parts catalog MCP for RealOEM",
  "bin": {
    "realoem-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "browser:install": "playwright install chromium",
    "format": "prettier --write \"{src,test}/**/*.ts\" package.json tsconfig*.json wrangler.jsonc .prettierrc.json",
    "format:check": "prettier --check \"{src,test}/**/*.ts\" package.json tsconfig*.json wrangler.jsonc .prettierrc.json",
    "worker:types": "wrangler types src/worker-env.d.ts --include-runtime false",
    "worker:check": "npm run worker:types && tsc -p tsconfig.worker.json",
    "worker:dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "worker:build": "wrangler deploy --dry-run --outdir .wrangler/build",
    "test:worker": "npm run worker:build && tsx --test test/worker/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "cheerio": "^1.1.2",
    "playwright": "^1.56.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@types/node": "^24.0.0",
    "miniflare": "^5.20261006.1-alpha",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.149.0"
  },
  "cloudflare": {
    "bindings": {
      "MCP_AUTH_TOKEN": {
        "description": "Generate a random token with `openssl rand -hex 32`. Supply it as `Authorization: Bearer <token>` when connecting to your deployed MCP."
      },
      "CATALOG": {
        "description": "Coordinates RealOEM requests and caches catalog pages for this deployment."
      }
    }
  }
}
